DISCORD_TOKEN=replace-with-discord-bot-token
BOT_OWNER_ID=1435161291365814325
OFFICIAL_CHANNEL_ID=0
COMMAND_PREFIX=php!
# Local development default:
DATABASE_URL=sqlite+aiosqlite:///./phpelefant-discord.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://phpelefant:phpelefant@postgres:5432/phpelefant_discord
LOG_LEVEL=INFO
ENABLE_EVAL=false
SHELL_WORKING_DIRECTORY=.
SHELL_PATH=/bin/sh
SHELL_RUNTIME_USER=phpelefant-env
SHELL_ENFORCE_RUNTIME_USER=true
SHELL_TIMEOUT_SECONDS=10
SHELL_OUTPUT_LIMIT=3500
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=CET
XP_COOLDOWN_SECONDS=45